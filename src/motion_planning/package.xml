<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_planning</name>
  <version>0.0.1</version>
  <description>
    Joystick-driven MoveIt Servo teleoperation node for the ASHR project.
    Subscribes to /joy and publishes TwistStamped (Cartesian) and JointJog
    commands to the servo node. Supports toggling between base/EEF frames
    and between Cartesian/joint-space control modes.
  </description>

  <maintainer email="todo@todo.com">ASHR Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS core -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <!-- Messages -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <!-- MoveIt Servo -->
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_servo</depend>

  <!-- Joy driver -->
  <depend>joy</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
