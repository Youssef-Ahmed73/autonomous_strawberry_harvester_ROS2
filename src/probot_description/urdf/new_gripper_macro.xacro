<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="probot_gripper" params="parent">

    <!-- Materials used by the gripper -->
    <material name="gripper_grey">
      <color rgba="0.69804 0.69804 0.69804 1" />
    </material>
    <material name="gripper_arm_material">
      <color rgba="0.79216 0.81961 0.93333 1" />
    </material>

    <!-- Main attachment joint connecting the arm's link_6 to the new gripper base -->
    <joint name="arm_gripper_joint" type="fixed">
      <origin xyz="0 -0.013 0" rpy="1.5708 0 0" />
      <parent link="${parent}" />
      <child link="gripper_base" />
    </joint>

    <!-- Base Gripper Link -->
    <link name="gripper_base">
      <visual>
        <origin xyz="0.003433 -0.004963 0.078431" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Container_link_001_collision.stl" />
        </geometry>
        <material name="gripper_grey" />
      </visual>
      <collision>
        <origin xyz="0.003433 -0.004963 0.078431" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Container_link_001_collision.stl" />
        </geometry>
      </collision>
    </link>

    <!-- Door -->
    <link name="Door_Link">
      <visual>
        <origin xyz="0.05311 -0.050603 0.025" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Door_Link_collision.stl" />
        </geometry>
        <material name="gripper_grey" />
      </visual>
      <collision>
        <origin xyz="0.05311 -0.050603 0.025" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Door_Link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="Door_Joint" type="revolute">
      <origin xyz="-0.032577 -0.08274 0.081" rpy="3.141585 0 0" />
      <parent link="gripper_base" />
      <child link="Door_Link" />
      <axis xyz="0 0 1" />
      <limit effort="10" velocity="6.26" lower="0" upper="3.14" />
    </joint>

    <!-- Active Gear and Blade -->
    <link name="Active_Gear_Link">
     <inertial>
        <origin xyz="0.00040341000589738 -0.0028994921557112 0.00197147955183292" rpy="0 0 0" />
        <mass value="0.00284856456686766" />
        <inertia ixx="2.35656397042425E-07" ixy="8.29499629182763E-10" ixz="-2.06306214180894E-08" iyy="3.62849121452055E-07" iyz="4.23956057615974E-09" izz="1.36875683236315E-07" />
      </inertial>
      <visual>
        <origin xyz="0.001392 -0.001535 0.00345" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Active_Scissors_Gear_Link_collision.stl" />
        </geometry>
        <material name="gripper_grey" />
      </visual>
      <collision>
        <origin xyz="0.001392 -0.001535 0.00345" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Active_Scissors_Gear_Link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="Active_Gear_Joint" type="revolute">
      <origin xyz="0.011675 -0.055124 0.1222" rpy="0 0 0" />
      <parent link="gripper_base" />
      <child link="Active_Gear_Link" />
      <axis xyz="0 0 -1" />
      <limit effort="10" velocity="6.28" lower="0" upper="0.56" />
    </joint>

    <link name="Active_Blade_Link">
      <inertial>
        <origin xyz="-0.00154255115951425 -0.0255142318483652 -0.0018089155442183" rpy="0 0 0" />
        <mass value="0.00546626517024223" />
        <inertia ixx="1.61947094236475E-06" ixy="2.3864307836331E-08" ixz="1.49553151926955E-10" iyy="2.91612156814121E-08" iyz="1.41923125794946E-09" izz="1.64459449291055E-06" />
      </inertial>
      <visual>
        <origin xyz="-0.014347 0.0407 0.00245" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Active_Blade_Link_collision.stl" />
        </geometry>
        <material name="gripper_arm_material" />
      </visual>
      <collision>
        <origin xyz="-0.014347 0.0407 0.00245" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Active_Blade_Link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="Active_Blade_Joint" type="fixed">
      <origin xyz="0.013645 -0.013931 0.0069" rpy="0 0 0" />
      <parent link="Active_Gear_Link" />
      <child link="Active_Blade_Link" />
    </joint>

    <!-- Passive Gear and Blade -->
    <link name="Passive_Gear_Link">
      <inertial>
        <origin xyz="-0.000253400477745899 -0.00227133697178923 0.00309286454693159" rpy="0 0 0" />
        <mass value="0.00320790725939746" />
        <inertia ixx="2.82029475359522E-07" ixy="-1.16262919185086E-09" ixz="1.21504474417119E-08" iyy="4.04760375455283E-07" iyz="1.34798056582785E-08" izz="1.37169661043404E-07" />
      </inertial>
      <visual>
        <origin xyz="0 -0.004234 0.0036" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Passive_Scissors_Gear_Link_collision.stl" />
        </geometry>
        <material name="gripper_grey" />
      </visual>
      <collision>
        <origin xyz="0 -0.004234 0.0036" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Passive_Scissors_Gear_Link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="Passive_Scissors_Gear_Joint" type="revolute">
      <origin xyz="0.035648 -0.043956 0.1231" rpy="0 0 0" />
      <parent link="gripper_base" />
      <child link="Passive_Gear_Link" />
      <axis xyz="0 0 1" />
      <limit effort="10" velocity="6.28" lower="-6.28" upper="6.28" />
      <mimic joint="Active_Gear_Joint" multiplier="1.0" offset="0.0"/>
    </joint>

    <link name="Passive_Blade_Link">
      <inertial>
        <origin xyz="-0.0108189596133123 0.0232787197714948 0.00489030573864965" rpy="0 0 0" />
        <mass value="0.00546978333218875" />
        <inertia ixx="1.39437733552038E-06" ixy="5.61593218262089E-07" ixz="7.42692648485945E-10" iyy="2.59809958482698E-07" iyz="-1.33879102104523E-09" izz="1.65014466299776E-06" />
      </inertial>
      <visual>
        <origin xyz="-0.021054 0.037986 0.00245" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Passive_Blade_Link_collision.stl" />
        </geometry>
        <material name="gripper_arm_material" />
      </visual>
      <collision>
        <origin xyz="-0.021054 0.037986 0.00245" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/Passive_Blade_Link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="Passive_Blade_Joint" type="fixed">
      <origin xyz="0.002644 -0.01932 0.0072" rpy="0 0 0" />
      <parent link="Passive_Gear_Link" />
      <child link="Passive_Blade_Link" />
    </joint>

    <!-- Cameras (in Z direction) -->
    <link name="Camera1_Link" />
    <joint name="Camera1_Joint" type="fixed">
      <origin xyz="-0.035467 -0.044923 0.1035" rpy="-1.570708 0.650634 -0.659391" />
      <parent link="gripper_base" />
      <child link="Camera1_Link" />
    </joint>

    <link name="Camera2_Link" />
    <joint name="Camera2_Joint" type="fixed">
      <origin xyz="0.035467 0.044923 0.1035" rpy="1.545062 -0.016276 -0.674778" />
      <parent link="gripper_base" />
      <child link="Camera2_Link" />
    </joint>

    <!-- LEDs (in X direction) -->
    <link name="LED1_Link" />
    <joint name="LED1_Link_joint" type="fixed">
      <origin xyz="-0.040844 -0.003573 0.1229" rpy="0 0 0" />
      <parent link="gripper_base" />
      <child link="LED1_Link" />
    </joint>

    <link name="LED2_Link" />
    <joint name="LED2_Joint" type="fixed">
      <origin xyz="0.040757 0.003506 0.1229" rpy="0 0 3.1416" />
      <parent link="gripper_base" />
      <child link="LED2_Link" />
    </joint>

  </xacro:macro>
</robot>