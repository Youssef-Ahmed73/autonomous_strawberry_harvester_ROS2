<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="probot_anno_macro" params="use_gazebo">
    <xacro:property name="M_PI" value="3.1415926536"/>


    <!-- Materials -->
    <material name="offwhite">
      <color rgba="0.95 0.95 0.92 1" />
    </material>
    <material name="kinect_dark">
      <color rgba="0.15 0.15 0.15 1" /> <!-- The classic dark matte grey of the Kinect -->
    </material>

    <!-- Fix robot to world -->
    <link name="world"/>
    <joint name="world_to_robot_base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="world" />
      <child link="robot_base" />
    </joint>

    <!-- New Robot Base -->
    <link name="robot_base">
      <inertial>
        <origin xyz="-0.26475 0.051293 0.019346" rpy="0 0 0" />
        <mass value="1.4191" />
        <inertia ixx="0.012341" ixy="0.0054099" ixz="0.0023347" iyy="0.03677" iyz="-0.0018374" izz="0.047034" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/robot_base.STL" />
        </geometry>
      <material name="kinect_dark" /> 
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/robot_base.STL" />
        </geometry>
      </collision>
    </link>

    <!-- Kinect optical frames -->
    <link name="camera_link1"/>
    <joint name="camera_joint1" type="fixed">
      <origin xyz="-0.27393 0.13681 0.05339" rpy="-1.509 0 0" />
      <parent link="robot_base" />
      <child link="camera_link1" />
    </joint>

    <link name="camera_link2"/>
    <joint name="camera_joint2" type="fixed">
      <origin xyz="-0.32393 0.13681 0.05339" rpy="-1.509 0 0" />
      <parent link="robot_base" />
      <child link="camera_link2" />
    </joint>

    <link name="camera_link3"/>
    <joint name="camera_joint3" type="fixed">
      <origin xyz="-0.34993 0.13681 0.05339" rpy="-1.509 0 0" />
      <parent link="robot_base" />
      <child link="camera_link3" />
    </joint>

    <link name="base_footprint"/>
    <joint name="robot_base_to_base_footprint" type="fixed">
      <origin xyz="0 0 -0.017" rpy="0 0 0"/>
      <parent link="robot_base"/>
      <child link="base_footprint"/>
    </joint>

    <joint name="joint_0" type="fixed">
      <origin xyz="0 0 0.0532" rpy="0 0 0" />
      <parent link="base_footprint" />
      <child link="base_link" />
    </joint>

    <link name="base_link">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="0.286755864167795" />
        <inertia
          ixx="0.000914891478336648" ixy="-9.74616219194614E-08" ixz="-1.22707969258407E-10"
          iyy="0.000918304334803416" iyz="-7.53317610970858E-09" izz="0.00181941891671005" />
      </inertial>
      <visual>
        <origin xyz="0.017266 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/new_base_link.stl" />
        </geometry>
      <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0.017266 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/new_base_link.stl" />
        </geometry>
      </collision>
    </link>

    <link name="link_1">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="1.50473234946919" />
        <inertia
          ixx="0.00667121219534555" ixy="-8.54445620252032E-06" ixz="1.56560865622562E-07"
          iyy="0.00595997019373921" iyz="0.000424090863023404" izz="0.006430374759868" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_1.STL" />
        </geometry>
        <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_1.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="joint_1" type="revolute">
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <parent link="base_link" />
      <child link="link_1" />
      <axis xyz="0 1 0" />
      <limit lower="-3.1416" upper="3.1416" effort="100" velocity="3" />
    </joint>

    <link name="link_2">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="1.00050619907027" />
        <inertia
          ixx="0.0014522332353461" ixy="-8.9482731163037E-06" ixz="2.82386498605548E-05"
          iyy="0.00136522040691973" iyz="3.07414967244519E-06" izz="0.0024851244648194" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_2.STL" />
        </geometry>
        <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_2.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="joint_2" type="revolute">
      <origin xyz="0 0.2305 0" rpy="0 0 0" />
      <parent link="link_1" />
      <child link="link_2" />
      <axis xyz="0 0 1" />
      <limit lower="-2.0071" upper="2.0071" effort="100" velocity="3" />
    </joint>

    <link name="link_3">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="0.549520755006072" />
        <inertia
          ixx="0.000672536702276881" ixy="-6.59360128441997E-06" ixz="-9.19434642556495E-07"
          iyy="0.000480817179261754" iyz="4.15241325610066E-06" izz="0.001032595781869" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_3.STL" />
        </geometry>
        <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_3.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="joint_3" type="revolute">
      <origin xyz="0 0.225 0" rpy="0 0 1.5708" />
      <parent link="link_2" />
      <child link="link_3" />
      <axis xyz="0 0 1" />
      <limit lower="-2.2689" upper="2.2689" effort="100" velocity="3" /> 
    </joint>

    <link name="link_4">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="0.952497713016407" />
        <inertia
          ixx="0.00530614361480367" ixy="7.10404845280282E-20" ixz="-3.14301719378985E-20"
          iyy="0.00354259274696511" iyz="-6.5480532041068E-19" izz="0.00221010202882688" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_4.STL" />
        </geometry>
        <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_4.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="joint_4" type="revolute">
      <origin xyz="0.021 0 0.002" rpy="0 0 0" />
      <parent link="link_3" />
      <child link="link_4" />
      <axis xyz="1 0 0" />
      <limit lower="-3.1416" upper="3.1416" effort="100" velocity="3" />
    </joint>

    <link name="link_5">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="0.393287799668792" />
        <inertia
          ixx="0.000319382332386347" ixy="-9.00754957688623E-10" ixz="-1.75182555785641E-09"
          iyy="0.000272873273899642" iyz="-4.5738506474632E-10" izz="0.000292993325719614" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_5.STL" />
        </geometry>
        <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_5.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="joint_5" type="revolute">
      <origin xyz="0.20586 0 0" rpy="0 0 1.5708" />
      <parent link="link_4" />
      <child link="link_5" />
      <axis xyz="0 0 1" />
      <limit lower="-2.3562" upper="2.3562" effort="100" velocity="3" />
    </joint>

    <link name="link_6">
      <inertial>
        <origin xyz="-0.010934 0.23134 0.0051509" rpy="0 0 0" />
        <mass value="0.00628105868776632" />
        <inertia
          ixx="5.52992389755476E-07" ixy="-2.81554428275222E-22" ixz="-1.40088624914581E-22"
          iyy="5.52992389755476E-07" iyz="4.83070888700992E-24" izz="1.08002978042972E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_6.STL" />
        </geometry>
        <material name="offwhite" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://probot_description/meshes/link_6.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="joint_6" type="revolute">
      <origin xyz="0 -0.042 0" rpy="0 0 0" />
      <parent link="link_5" />
      <child link="link_6" />
      <axis xyz="0 -1 0" />
      <limit lower="-3.1416" upper="3.1416" effort="100" velocity="3" />
    </joint>

    <!--link name="tool0"/>
    <joint name="joint_tool0" type="fixed">
      <origin xyz="0 -0.013 0" rpy="0 0 0" />
      <parent link="link_6" />
      <child link="tool0" />
    </joint-->
    
    <!-- ========================================================= -->
    <!-- GAZEBO SENSORS: KINECT RGB-D                              -->
    <!-- ========================================================= -->
    <xacro:if value="${use_gazebo}">
      <gazebo reference="camera_link2">
        <sensor name="kinect_rgbd" type="rgbd_camera">
          <pose>0 0 0.01 1.5708 -1.5708 0</pose>
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <visualize>true</visualize>
          <topic>/camera/kinect</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
    
    </xacro:macro>
</robot>